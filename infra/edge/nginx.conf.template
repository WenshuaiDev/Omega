worker_processes auto;
pid /tmp/nginx.pid;
error_log /dev/stderr warn;
events { worker_connections 1024; }
http {
    include /etc/nginx/mime.types;
    access_log /dev/stdout;
    server_tokens off;
    client_body_temp_path /tmp/client_temp;
    proxy_temp_path /tmp/proxy_temp;
    fastcgi_temp_path /tmp/fastcgi_temp;
    uwsgi_temp_path /tmp/uwsgi_temp;
    scgi_temp_path /tmp/scgi_temp;
    resolver 127.0.0.11 valid=5s ipv6=off;
    resolver_timeout 3s;
    map $http_upgrade $connection_upgrade { default upgrade; '' close; }
    # Only an operator sharing the edge network namespace can verify ordinary
    # TLS routes while the public maintenance gate remains closed.
    map $remote_addr $maintenance_file {
        default /etc/omega/edge/maintenance;
        127.0.0.1 /etc/omega/edge/no-maintenance-bypass-file;
        ::1 /etc/omega/edge/no-maintenance-bypass-file;
    }
    # REDIRECT_SERVER
    server {
        @@LISTEN@@
        server_name @@DOMAIN@@;
        @@TLS@@
        if (-f $maintenance_file) { return 503; }
        location = / { return 302 /web/; }
        location = /web { return 308 /web/; }
        location = /console { return 308 /console/; }
        location = /web/runtime-config.json {
            alias /etc/omega/public/web.json;
            default_type application/json;
            add_header Cache-Control "no-store" always;
        }
        location = /console/runtime-config.json {
            alias /etc/omega/public/console.json;
            default_type application/json;
            add_header Cache-Control "no-store" always;
        }
        location /api/ {
            set $api http://api:8080;
            proxy_pass $api$request_uri;
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_connect_timeout 5s;
            proxy_read_timeout 65s;
        }
        location /web/ {
            set $web http://web:@@APP_PORT@@;
            proxy_pass $web$request_uri;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_read_timeout 3600s;
        }
        location /console/ {
            set $console http://console:@@APP_PORT@@;
            proxy_pass $console$request_uri;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_read_timeout 3600s;
        }
        location / { return 404; }
    }
}
